diff --git a/lib/utils/update_helper.dart b/lib/utils/update_helper.dart
new file mode 100644
--- /dev/null
+++ b/lib/utils/update_helper.dart
@@ -0,0 +1,82 @@
+abstract final class UpdateHelper {
+  static final RegExp _apkPattern = RegExp(
+    r'^PiliPlus-tv\.danmaku\.bili_(.+)\+([0-9]+)_(arm64-v8a|armeabi-v7a|x86_64)\.apk$',
+  );
+
+  static int? versionCodeFromAssetName(String name) {
+    final match = _apkPattern.firstMatch(name);
+    return match == null ? null : int.tryParse(match.group(2)!);
+  }
+
+  static String? abiFromAssetName(String name) =>
+      _apkPattern.firstMatch(name)?.group(3);
+
+  static bool isExpectedDownloadUrl(
+    String? value,
+    String owner,
+    String repository,
+  ) {
+    if (value == null || owner.isEmpty || repository.isEmpty) return false;
+    final uri = Uri.tryParse(value);
+    if (uri == null || uri.scheme != 'https' || uri.host != 'github.com') {
+      return false;
+    }
+    final segments = uri.pathSegments;
+    return segments.length >= 4 &&
+        segments[0] == owner &&
+        segments[1] == repository &&
+        segments[2] == 'releases' &&
+        segments[3] == 'download';
+  }
+
+  static Iterable<Map<String, dynamic>> _assets(Map<String, dynamic> release) {
+    final assets = release['assets'];
+    if (assets is! List) return const <Map<String, dynamic>>[];
+    return assets.whereType<Map>().map(Map<String, dynamic>.from);
+  }
+
+  static int? releaseVersionCode(Map<String, dynamic> release) {
+    final codes = _assets(release)
+        .map((asset) => versionCodeFromAssetName('${asset['name']}'))
+        .whereType<int>()
+        .toSet();
+    return codes.length == 1 ? codes.single : null;
+  }
+
+  static Map<String, dynamic>? latestValidRelease(Object? payload) {
+    if (payload is! List) return null;
+    for (final rawRelease in payload.whereType<Map>()) {
+      final release = Map<String, dynamic>.from(rawRelease);
+      if (release['draft'] == true || release['prerelease'] == true) continue;
+      if (releaseVersionCode(release) != null) return release;
+    }
+    return null;
+  }
+
+  static Map<String, dynamic>? assetForAbis(
+    Map<String, dynamic> release,
+    Iterable<String> supportedAbis,
+    String owner,
+    String repository,
+  ) {
+    final assets = _assets(release).toList(growable: false);
+    for (final abi in supportedAbis) {
+      for (final asset in assets) {
+        if (abiFromAssetName('${asset['name']}') == abi &&
+            isExpectedDownloadUrl(
+              asset['browser_download_url']?.toString(),
+              owner,
+              repository,
+            )) {
+          return asset;
+        }
+      }
+    }
+    return null;
+  }
+
+  static bool hasUpdate(Map<String, dynamic> release, int currentVersionCode) {
+    final latestVersionCode = releaseVersionCode(release);
+    return latestVersionCode != null && latestVersionCode > currentVersionCode;
+  }
+}
diff --git a/test/fork_update_helper_test.dart b/test/fork_update_helper_test.dart
new file mode 100644
--- /dev/null
+++ b/test/fork_update_helper_test.dart
@@ -0,0 +1,85 @@
+import 'package:PiliPlus/utils/update_helper.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+Map<String, dynamic> release({
+  int code = 5281,
+  bool draft = false,
+  bool prerelease = false,
+  String owner = 'mi0e',
+  String repository = 'PiliPlus',
+}) => {
+  'draft': draft,
+  'prerelease': prerelease,
+  'tag_name': 'v2.1.2.3-bili.1',
+  'assets': [
+    for (final abi in ['arm64-v8a', 'armeabi-v7a', 'x86_64'])
+      {
+        'name': 'PiliPlus-tv.danmaku.bili_2.1.2.3-bili.1+${code}_$abi.apk',
+        'browser_download_url':
+            'https://github.com/$owner/$repository/releases/download/v2.1.2.3-bili.1/app.apk',
+      },
+  ],
+};
+
+void main() {
+  test('parses the version contract', () {
+    expect(
+      UpdateHelper.versionCodeFromAssetName(
+        'PiliPlus-tv.danmaku.bili_2.1.2.3-bili.1+5281_arm64-v8a.apk',
+      ),
+      5281,
+    );
+    expect(UpdateHelper.versionCodeFromAssetName('PiliPlus.apk'), isNull);
+  });
+
+  test('ignores draft, prerelease and invalid releases', () {
+    final valid = release();
+    expect(
+      UpdateHelper.latestValidRelease([
+        release(draft: true),
+        release(prerelease: true),
+        {'assets': []},
+        valid,
+      ]),
+      equals(valid),
+    );
+    expect(UpdateHelper.latestValidRelease({'message': 'rate limited'}), isNull);
+  });
+
+  test('compares monotonically increasing version codes', () {
+    expect(UpdateHelper.hasUpdate(release(), 5280), isTrue);
+    expect(UpdateHelper.hasUpdate(release(), 5281), isFalse);
+    expect(UpdateHelper.hasUpdate(release(), 5282), isFalse);
+  });
+
+  test('selects the first supported ABI from the configured repository', () {
+    final asset = UpdateHelper.assetForAbis(
+      release(),
+      ['x86_64', 'arm64-v8a'],
+      'mi0e',
+      'PiliPlus',
+    );
+    expect(UpdateHelper.abiFromAssetName('${asset?['name']}'), 'x86_64');
+    expect(
+      UpdateHelper.assetForAbis(
+        release(owner: 'bggRGjQaUbCoE'),
+        ['arm64-v8a'],
+        'mi0e',
+        'PiliPlus',
+      ),
+      isNull,
+    );
+  });
+
+  test('rejects empty and non-release repository URLs', () {
+    expect(UpdateHelper.isExpectedDownloadUrl(null, 'mi0e', 'PiliPlus'), isFalse);
+    expect(
+      UpdateHelper.isExpectedDownloadUrl(
+        'https://github.com/mi0e/PiliPlus/issues',
+        'mi0e',
+        'PiliPlus',
+      ),
+      isFalse,
+    );
+  });
+}
